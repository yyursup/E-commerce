# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_SECRET=your_256_bit_secret_key_min_32_characters_for_hs256
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# =============================================================================
# MINIO (S3 COMPATIBLE STORAGE)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_BUCKET_NAME=ecommerce

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# =============================================================================
# VNPT EKYC CONFIGURATION
# =============================================================================
VNPT_EKYC_BASE_URL=https://ekyc.vnpt.ai/v1
VNPT_EKYC_ACCESS_TOKEN=your_vnpt_access_token
VNPT_EKYC_TOKEN_ID=your_vnpt_token_id
VNPT_EKYC_TOKEN_KEY=your_vnpt_token_key

# =============================================================================
# GHN EXPRESS LOGISTICS
# =============================================================================
GHN_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=your_ghn_token
GHN_SHOP_ID=your_shop_id

# =============================================================================
# VNPAY PAYMENT GATEWAY
# =============================================================================
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment-result

# =============================================================================
# LIVEKIT STREAMING CONFIGURATION
# =============================================================================
# IMPORTANT: Get your credentials from https://cloud.livekit.io/
# After creating a project, add the following to your environment:
LIVEKIT_URL=wss://your-project-name.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# =============================================================================
# GEMINI / AI CONFIGURATION (FOR CHATBOT & RECOMMENDATIONS)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_VERSION=gemini-2.5-flash
# Optional OpenAI-compatible AI provider (defaults to Gemini endpoint)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=your_ai_api_key
# AI_MODEL=gemini-2.5-flash

# =============================================================================
# OAUTH2 CONFIGURATION (OPTIONAL)
# =============================================================================
OAUTH2_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH2_GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH2_FACEBOOK_CLIENT_ID=your_facebook_client_id
OAUTH2_FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# =============================================================================
# FRONTEND URLS
# =============================================================================
FRONTEND_URL=http://localhost:3000
SELLER_FRONTEND_URL=http://localhost:3001
ADMIN_FRONTEND_URL=http://localhost:3002
